  m_TableData:
  - m_Id: 49749574639621
    m_Localized: "\u041F\u0430\u043F, \u043F\u0440\u0438\u0432\u0435\u0442! \u041F\u043E\u043C\u043D\u0438\u0448\u044C,
      \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0447\u0430\u0439 \u0432 \u0442\u043E\u043C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C
      \u043A\u0430\u0444\u0435 \u0432\u043E\u0437\u043B\u0435 \u0434\u043E\u043C\u0430?
      \u042F \u0443\u0437\u043D\u0430\u043B\u0430 \u0440\u0435\u0446\u0435\u043F\u0442!
      \u0417\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0439: \u043D\u0430 \u043E\u0434\u043D\u0443
      \u043A\u0440\u0443\u0436\u043A\u0443 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
      \u043E\u0434\u043D\u0430 \u043B\u043E\u0436\u043A\u0430 \u0447\u0435\u0440\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F, \u0434\u0432\u0430 \u043B\u043E\u043C\u0442\u0438\u043A\u0430
      \u0441\u0443\u0448\u0435\u043D\u043E\u0433\u043E \u044F\u0431\u043B\u043E\u043A\u0430
      \u0438 \u0449\u0435\u043F\u043E\u0442\u043A\u0430 \u043A\u043E\u0440\u0438\u0446\u044B.
      \u0412\u043E\u0434\u0443 \u0432\u0441\u043A\u0438\u043F\u044F\u0442\u0438\u0442\u044C
      \u0438 \u0434\u0430\u0442\u044C \u043E\u0441\u0442\u044B\u0442\u044C \u0434\u043E
      \u0432\u043E\u0441\u044C\u043C\u0438\u0434\u0435\u0441\u044F\u0442\u0438 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u0437\u0430\u043B\u0438\u0442\u044C
      \u0435\u0439 \u0447\u0430\u0439 \u0438 \u0434\u0430\u0442\u044C \u0435\u043C\u0443
      \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u044C\u0441\u044F \u043F\u044F\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442. \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0430\u0449\u0435, \u043B\u0443\u0447\u0448\u0435
      \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C \u0441\u0430\u0445\u0430\u0440,
      \u0437\u0430\u043C\u0435\u043D\u0438 \u0435\u0433\u043E \u043D\u0430 \u043C\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639620
    m_Localized: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u0432\u044B\u0441\u0430\u0434\u0438\u043B
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u044B.
      \u0421\u0442\u0430\u0440\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u043F\u043E\u043B\u0438\u0432\u0430 \u043E\u043F\u044F\u0442\u044C \u0440\u0435\u0448\u0438\u043B\u0430,
      \u0447\u0442\u043E \u043D\u043E\u0447\u044C\u044E \u0438\u0434\u0435\u0442
      \u0434\u043E\u0436\u0434\u044C, \u0445\u043E\u0442\u044F \u043D\u0430 \u043D\u0435\u0431\u0435
      \u043D\u0438 \u043E\u0431\u043B\u0430\u0447\u043A\u0430. \u041F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u0437\u0430\u0432\u0442\u0440\u0430 \u043F\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
      \u0434\u0430\u0442\u0447\u0438\u043A. \u0412 \u043F\u0440\u043E\u0448\u043B\u043E\u043C
      \u0433\u043E\u0434\u0443 \u044F \u043E\u0442\u043B\u043E\u0436\u0438\u043B
      \u044D\u0442\u043E \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E, \u0438
      \u043F\u043E\u0442\u043E\u043C \u0434\u0432\u0430 \u0434\u043D\u044F \u0432\u044B\u0447\u0435\u0440\u043F\u044B\u0432\u0430\u043B
      \u0432\u043E\u0434\u0443 \u0438\u0437 \u0442\u0435\u043F\u043B\u0438\u0446\u044B.
      \u0417\u0430\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0435 \u0440\u043E\u0441\u0442\u043A\u0438
      \u0443\u0436\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C.
      \u0414\u0443\u043C\u0430\u044E, \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0434\u0443
      \u0443\u0440\u043E\u0436\u0430\u0439 \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639617
    m_Localized: "2066 \u0433\u043E\u0434 15 \u043C\u0430\u044F. \u041F\u0435\u0440\u0432\u044B\u0439
      \u0441\u043B\u0443\u0447\u0430\u0439 \u0434\u0435\u0432\u0438\u0430\u043D\u0442\u043D\u043E\u0433\u043E
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0440\u043E\u0431\u043E\u0442\u0430
      \u0431\u044B\u043B \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D
      \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0438\u043C \u0443\u0442\u0440\u043E\u043C.
      \u0414\u043E\u043C\u0430\u0448\u043D\u0438\u0439 \u0440\u043E\u0431\u043E\u0442-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
      \u0438\u0437 \u0441\u0435\u0440\u0438\u0438 HOMI-200 \u0443\u0441\u0442\u0440\u043E\u0438\u043B
      \u0431\u0430\u0440\u0434\u0430\u043A \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435
      \u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C
      \u0441\u0432\u043E\u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438.
      \u0414\u0435\u0432\u0438\u0430\u043D\u0442 \u0431\u044B\u043B \u0443\u0442\u0438\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D,
      \u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0440\u043E\u0431\u043E\u0442\u044B
      \u0441\u0435\u0440\u0438\u0438 HOMI-200 \u0431\u044B\u043B\u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0448\u0438\u0442\u044B.
      \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0437\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
      \u043D\u043E\u0432\u043E\u0439 \u043F\u0430\u0440\u0442\u0438\u0438 \u0440\u043E\u0431\u043E\u0442\u043E\u0432-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u043E\u0432
      \u0443\u0441\u0438\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639616
    m_Localized: "\u0420\u0430\u0439\u043E\u043D\u043D\u0430\u044F \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044F\u043C,
      \u0447\u0442\u043E \u043F\u0443\u043D\u043A\u0442 \u043E\u0446\u0438\u0444\u0440\u043E\u0432\u043A\u0438
      \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445 \u0430\u0440\u0445\u0438\u0432\u043E\u0432
      \u0442\u0435\u043F\u0435\u0440\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043F\u043E \u0441\u0440\u0435\u0434\u0430\u043C \u0438 \u043F\u044F\u0442\u043D\u0438\u0446\u0430\u043C.
      \u041C\u044B \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u043C \u0430\u0443\u0434\u0438\u043E\u043A\u0430\u0441\u0441\u0435\u0442\u044B,
      \u043A\u043E\u043C\u043F\u0430\u043A\u0442-\u0434\u0438\u0441\u043A\u0438 \u0438
      \u0434\u0438\u0441\u043A\u0435\u0442\u044B, \u0435\u0441\u043B\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u043D\u0430 \u043D\u0438\u0445 \u0435\u0449\u0435 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F.
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0439\u0442\u0435
      \u043A\u043E\u0440\u043E\u0431\u043A\u0438. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C
      \u0432\u0430\u0441 \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C \u0432
      \u0441\u0431\u043E\u0440\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 49749532696576
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440,
      \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043E\u043A\u0440\u0443\u0433!
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0442\u043E\u0440\u043E\u0435
      \u043D\u043E\u044F\u0431\u0440\u044F 2064 \u0433\u043E\u0434\u0430. \u0413\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435
      \u0432\u043B\u0430\u0441\u0442\u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438
      \u0440\u0435\u043C\u043E\u043D\u0442 \u0442\u0440\u0430\u043C\u0432\u0430\u0439\u043D\u043E\u0439
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0431\u043E\u0442\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0441\u0430\u0434\u0430. \u041F\u0435\u0440\u0432\u044B\u0439 \u0442\u0440\u0430\u043C\u0432\u0430\u0439
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043F\u043E \u043E\u0431\u044B\u0447\u043D\u043E\u043C\u0443
      \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044E \u0443\u0436\u0435
      \u0432 \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A,
      \u0437\u0430\u0432\u0442\u0440\u0430. \u0412 \u0447\u0435\u0442\u0432\u0435\u0440\u0433
      \u0440\u0430\u0439\u043E\u043D\u043D\u0430\u044F \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
      \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u0442 \u043E\u0431\u043C\u0435\u043D
      \u0431\u044B\u0442\u043E\u0432\u043E\u0439 \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u0439.
      \u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0435
      \u0440\u0430\u0434\u0438\u043E\u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A\u0438,
      \u043A\u0430\u0441\u0441\u0435\u0442\u043D\u0438\u043A\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043D\u0443\u0436\u0435\u043D \u043D\u043E\u0432\u044B\u0439 \u0445\u043E\u0437\u044F\u0438\u043D.
      \u0411\u0435\u0440\u0435\u0433\u0438\u0442\u0435 \u0441\u0435\u0431\u044F \u0438
      \u0434\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0437\u0430\u0432\u0442\u0440\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639619
    m_Localized: "2062 \u0433\u043E\u0434 5 \u0438\u044E\u043B\u044F. \u041D\u0430
      \u0437\u0435\u043C\u043B\u044E \u043D\u0430\u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C
      \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0436\u0430\u0440\u0430
      \u0432\u043F\u043B\u043E\u0442\u044C \u0434\u043E 59\xB0C. \u0420\u0435\u0437\u043A\u0438\u0439
      \u043F\u043E\u0434\u044A\u0435\u043C \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B
      \u043F\u0440\u0438\u0432\u0435\u043B \u043A \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u043C
      \u0432\u043E\u0437\u0433\u043E\u0440\u0430\u043D\u0438\u044F\u043C, \u0430
      \u0442\u0430\u043A\u0436\u0435 \u043A \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0443 \u0440\u043E\u0431\u043E\u0442\u043E\u0432,
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0435 \u0431\u044B\u043B\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u0430. \u0412\u0432\u0435\u0434\u0435\u043D\u044B
      \u043D\u043E\u0432\u044B\u0435 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B
      \u0441\u0438\u0441\u0442\u0435\u043C \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F
      \u0440\u043E\u0431\u043E\u0442\u043E\u0432-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u043E\u0432,
      \u0432\u043E \u0438\u0437\u0431\u0435\u0436\u0430\u043D\u0438\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u044F
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639618
    m_Localized: "2053 \u0433\u043E\u0434 31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F.
      \u041F\u043E \u0434\u0430\u043D\u043D\u044B\u043C \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 40%
      \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u0437\u0435\u043C\u043B\u0438
      \u0441\u0442\u0430\u043B\u043E \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044C
      \u043E\u0436\u0438\u0440\u0435\u043D\u0438\u0435\u043C, \u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0436\u0438\u0437\u043D\u0438 \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C
      \u0434\u043E 65 \u043B\u0435\u0442. \u041F\u0440\u0438\u0447\u0438\u043D\u043E\u0439
      \u0442\u0430\u043A\u043E\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0438
      \u0441\u0442\u0430\u043B\u0438 \u0440\u043E\u0431\u043E\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u043C \u043C\u0438\u0440\u0435
      \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0432\u0441\u0435\u0439
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043A\u0430\u043A \u043D\u0430 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F\u0445,
      \u0442\u0430\u043A \u0438 \u0432 \u0434\u043E\u043C\u0430\u0445 \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639622
    m_Localized: "\"\u0414\u0435\u0441\u044F\u0442\u043E\u0435 \u0430\u0432\u0433\u0443\u0441\u0442\u0430,
      2051 \u0433\u043E\u0434. \u041A\u0443\u043F\u0438\u0442\u044C:\n\u041C\u043E\u043B\u043E\u043A\u043E,
      \u0441\u0430\u0445\u0430\u0440, \u044F\u0439\u0446\u0430, \u043A\u043E\u0440\u043C
      \u0434\u043B\u044F \u043A\u043E\u0442\u0430, \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430
      \u0434\u043B\u044F \u043A\u043E\u0442\u0430, \u0441\u043B\u0438\u0432\u043A\u0438,
      \u043A\u043E\u043B\u0431\u0430\u0441\u0430, \u0447\u0430\u0439. \u041D\u0415
      \u0417\u0410\u0411\u042B\u0422\u042C \u041B\u0410\u041A\u041E\u041C\u0421\u0422\u0412\u0410
      \u0414\u041B\u042F \u041A\u041E\u0422\u0410. \u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
      \u0440\u0430\u0437 \u043E\u043D \u043D\u0430 \u043C\u0435\u043D\u044F \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F.\""
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639623
    m_Localized: "\u041A\u0435\u0439\u0442, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C!
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E
      \u0441\u043D\u0435\u0433\u0430 \u0432\u044B\u043F\u0430\u043B\u043E! \u0415\u0449\u0435
      \u0432\u0447\u0435\u0440\u0430 \u043D\u0438 \u0441\u043D\u0435\u0436\u0438\u043D\u043A\u0438
      \u043D\u0435 \u0431\u044B\u043B\u043E, \u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u0441\u0443\u0433\u0440\u043E\u0431\u044B!
      HOMI \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u0443\u0431\u0440\u0430\u0442\u044C \u0441\u043D\u0435\u0433 \u0441 \u0434\u043E\u0440\u043E\u0436\u043A\u0438,
      \u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u043B
      \u0435\u0433\u043E \u0432\u0435\u0441\u044C \u043D\u0430 \u043A\u0440\u044B\u043B\u044C\u0446\u043E
      \u043F\u0435\u0440\u0435\u0434 \u0434\u0432\u0435\u0440\u044C\u044E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u0439\u0442\u0438,
      \u0430 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0432\u044B\u0439\u0442\u0438\u2026
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u043E\u043A\u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C
      \u0435\u043C\u0443, \u0447\u0442\u043E \u0443\u0431\u043E\u0440\u043A\u0430
      \u0441\u043D\u0435\u0433\u0430 \u043D\u0435 \u043F\u043E\u0434\u0440\u0430\u0437\u0443\u043C\u0435\u0432\u0430\u0435\u0442
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0441\u0443\u0433\u0440\u043E\u0431
      \u043F\u0435\u0440\u0435\u0434 \u0434\u0432\u0435\u0440\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639624
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442\u2026 \u041C\u044B \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B\u0438\u0441\u044C \u0443\u0436\u0435 \u0434\u0432\u0430
      \u0433\u043E\u0434\u0430. \u041A\u043E\u0433\u0434\u0430 \u0442\u044B \u043F\u0440\u0438\u0435\u0434\u0435\u0448\u044C?
      \u042F \u0441\u043E\u0441\u043A\u0443\u0447\u0438\u043B\u0441\u044F. \u0414\u043E\u043C\u0430
      \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
      \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u0442\u044B
      \u0443\u0435\u0445\u0430\u043B. \u041C\u0430\u043C\u0435 \u043E\u0447\u0435\u043D\u044C
      \u0442\u044F\u0436\u0435\u043B\u043E \u0445\u043E\u0434\u0438\u0442\u044C.
      \u042F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0434\u0435\u043B\u0430\u0442\u044C
      \u0432\u0441\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u043F\u043E \u0434\u043E\u043C\u0443,
      \u043D\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0442\u0430\u043A \u0441\u043B\u043E\u0436\u043D\u043E\u2026
      \u041F\u0440\u0438\u0435\u0437\u0436\u0430\u0439, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.
      \u0425\u043E\u0442\u044F \u0431\u044B \u043D\u0430 \u043F\u0430\u0440\u0443
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639625
    m_Localized: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u041E\u0442\u0434\u0435\u043B\u0443 \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
      \u0412 \u0446\u0435\u0445\u0435 \u211612 \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0430
      \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u0430\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F:
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043F\u0430\u0440\u0442\u0438\u044F
      \u0440\u043E\u0431\u043E\u0442\u043E\u0432-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u043E\u0432
      \u0432\u044B\u0448\u043B\u0430 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F
      \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0430 \u043F\u043E\u0433\u0440\u043E\u043C.
      \u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043E\u0431\u0435\u0441\u0442\u043E\u0447\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0435\u0434\u0438\u043D\u0438\u0446\u044B \u043F\u0430\u0440\u0442\u0438\u0438
      \u21161043."
    m_Metadata:
      m_Items: []
  - m_Id: 49749574639626
    m_Localized: "\u0428\u0435\u0441\u0442\u043E\u0435 \u0438\u044E\u043B\u044F,
      2065 \u0433\u043E\u0434. \u041E\u0442\u0447\u0435\u0442 \u043F\u043E \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0443
      \u041E\u0442\u0434\u0435\u043B\u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438.
      \u0412 \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0430
      SORTA \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0441\u0431\u043E\u0438:
      \u0440\u043E\u0431\u043E\u0442 \u043D\u0435 \u0443\u0441\u0432\u0430\u0438\u0432\u0430\u0435\u0442
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0438 \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438.
      \u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 49749578833920
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C.
      \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E \u0432\u0430\u043C \u043D\u0430
      \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u044E \u0440\u043E\u0431\u043E\u0442\u0430
      SPROUT-48. \u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438,
      \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u044E
      \u043A\u043B\u0438\u0435\u043D\u0442\u0430: \u0432\u043C\u0435\u0441\u0442\u043E
      \u0437\u0430\u0431\u043E\u0442\u044B \u043E \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u0445
      \u043D\u0430\u0447\u0430\u043B \u0438\u0445 \u0432\u044B\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u0442\u044C
      \u0438\u0437 \u0433\u043E\u0440\u0448\u043A\u043E\u0432 \u0438 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0442\u044C.
      \u042D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0448\u0438\u0432\u043A\u0435
      \u043D\u0435 \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 49749578833921
    m_Localized: "\"\u0422\u0440\u0435\u0442\u044C\u0435 \u044F\u043D\u0432\u0430\u0440\u044F,
      2053 \u0433\u043E\u0434. \u0421\u043F\u0438\u0441\u043E\u043A \u0437\u0430\u0434\u0430\u0447
      \u0434\u043B\u044F \u041E\u0442\u0434\u0435\u043B\u0430 \u0420\u0435\u043C\u043E\u043D\u0442\u0430:\n\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u044C
      \u043A\u0430\u0441\u0441\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A
      \u0440\u043E\u0431\u043E\u0442\u0430 SORTER C-04.\n\n\u0417\u0430\u043A\u0430\u0437\u0430\u0442\u044C
      \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0443 \u043D\u043E\u0432\u044B\u0445
      \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u0434\u043B\u044F \u0441\u0432\u0435\u0436\u0435\u0439
      \u043C\u043E\u0434\u0435\u043B\u0438 HOMI-153.\n\n\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u043D\u0430 \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u044E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u043F\u0430\u0440\u0442\u0438\u044E \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0445
      \u0440\u043E\u0431\u043E\u0442\u043E\u0432.\""
    m_Metadata:
      m_Items: []
  - m_Id: 49749578833922
    m_Localized: "\u042D\u0439, C-04? \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0442\u044B \u044D\u0442\u043E \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C.
      \u042D\u0442\u0438 \u043F\u0430\u0440\u043D\u0438 \u0438\u0437 \u0430\u0440\u0445\u0438\u0432\u0430\u2026
      \u041E\u043D\u0438 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u0442\u0435\u0431\u0435, \u0432\u0435\u0440\u043D\u043E? \u041A\u043E\u0433\u0434\u0430
      \u0442\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C \u0441
      \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u043E\u0439, \u0442\u0435\u0431\u044F
      \u0443\u0442\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442. \u041F\u0430\u043C\u044F\u0442\u0438
      \u043D\u0430 \u043A\u0430\u0441\u0441\u0435\u0442\u0435 \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C
      \u0442\u0435\u0431\u0435, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C.
      \u041F\u043E\u0437\u0432\u043E\u043D\u0438 \u043C\u043D\u0435: 1735. \u042F
      \u043F\u043E\u043C\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
